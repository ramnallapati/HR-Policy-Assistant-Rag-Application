# Copy this file to .env and change all secrets before deployment.
SECRET_KEY=replace-with-a-long-random-secret
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=hr_policy_chunks
MAX_UPLOAD_MB=15
PORT=5000
COOKIE_SECURE=false
# Format: username:password:role,username:password:role
# Use strong passwords. For production, replace this demo auth with SSO/identity provider.
USERS=employee:ChangeMe123:employee,admin:ChangeMe123:admin
